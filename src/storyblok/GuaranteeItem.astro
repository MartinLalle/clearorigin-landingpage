---
import { storyblokEditable } from '@storyblok/astro';
const { blok } = Astro.props;
---

<article class="guarantee reveal" {...storyblokEditable(blok)}>
	<svg class="guarantee__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M12 2l8 3v7c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V5l8-3Z"></path>
		<path d="M8.5 12l2.5 2.5 4.5-5"></path>
	</svg>
	<h3 class="guarantee__title">{blok.title}</h3>
	<p class="guarantee__text">{blok.text}</p>
</article>

<style>
	.guarantee {
		border-top: 3px solid var(--forest);
		background: var(--forest-soft);
		border-radius: var(--radius-sm);
		padding: 26px 28px;
	}

	.guarantee__icon {
		width: 26px;
		height: 26px;
		color: var(--forest);
	}

	.guarantee__title {
		margin-top: 14px;
		font-size: 1.05rem;
		font-weight: 600;
	}

	.guarantee__text {
		margin-top: 8px;
		color: var(--text-muted);
		font-size: 0.94rem;
	}
</style>
