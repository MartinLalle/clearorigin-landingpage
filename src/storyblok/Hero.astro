---
import { storyblokEditable } from '@storyblok/astro';
const { blok } = Astro.props;
---

<section class="hero" {...storyblokEditable(blok)}>
	<svg class="parcel-motif hero__motif" viewBox="0 0 340 300" aria-hidden="true">
		<polygon points="20,110 90,30 210,18 320,80 290,210 150,270 40,230"></polygon>
		<circle cx="20" cy="110" r="3.5"></circle>
		<circle cx="90" cy="30" r="3.5"></circle>
		<circle cx="210" cy="18" r="3.5"></circle>
		<circle cx="320" cy="80" r="3.5"></circle>
		<circle cx="290" cy="210" r="3.5"></circle>
		<circle cx="150" cy="270" r="3.5"></circle>
		<circle cx="40" cy="230" r="3.5"></circle>
	</svg>

	<div class="container hero__inner">
		<div class="hero__copy">
			{blok.badge && <p class="hero__badge">{blok.badge}</p>}
			<h1 class="hero__headline">{blok.headline}</h1>
			<p class="hero__sub">{blok.subheadline}</p>
			<div class="hero__actions">
				{
					blok.cta_label && (
						<a class="btn btn--primary" href={blok.cta_link || '#cta'}>
							{blok.cta_label}
						</a>
					)
				}
				{
					blok.cta_secondary_label && (
						<a class="btn btn--ghost" href={blok.cta_secondary_link || '#how'}>
							{blok.cta_secondary_label}
						</a>
					)
				}
			</div>
		</div>

		{
			blok.image?.filename && (
				<figure class="hero__visual">
					<div class="hero__frame">
						<div class="hero__frame-bar" aria-hidden="true">
							<i /><i /><i />
						</div>
						<img
							src={blok.image.filename}
							alt={blok.image.alt || blok.image_alt || ''}
							loading="eager"
							fetchpriority="high"
						/>
					</div>
					{blok.image_caption && <figcaption class="geo-tag hero__caption">{blok.image_caption}</figcaption>}
				</figure>
			)
		}
	</div>
</section>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		padding-block: 88px 96px;
		background:
			radial-gradient(1100px 480px at 85% -10%, var(--orange-soft) 0%, transparent 60%),
			var(--paper);
	}

	.hero__motif {
		top: 40px;
		right: -60px;
		width: 380px;
	}

	.hero__inner {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 56px;
		align-items: center;
		position: relative;
	}

	.hero__badge {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.06em;
		color: var(--forest);
		background: var(--forest-soft);
		border: 1px solid color-mix(in srgb, var(--forest) 25%, transparent);
		display: inline-block;
		padding: 6px 14px;
		border-radius: 999px;
		margin-bottom: 22px;
	}

	.hero__headline {
		font-size: clamp(2.1rem, 4.6vw, 3.4rem);
		font-weight: 700;
		line-height: 1.08;
		letter-spacing: -0.02em;
	}

	.hero__sub {
		margin-top: 20px;
		font-size: 1.13rem;
		color: var(--text-muted);
		max-width: 50ch;
	}

	.hero__actions {
		margin-top: 34px;
		display: flex;
		gap: 14px;
		flex-wrap: wrap;
	}

	.hero__frame {
		border-radius: var(--radius);
		overflow: hidden;
		border: 1px solid var(--line);
		box-shadow: var(--shadow-card);
		background: var(--paper);
	}

	.hero__frame-bar {
		display: flex;
		gap: 6px;
		padding: 10px 14px;
		border-bottom: 1px solid var(--line);
		background: var(--mist);
	}

	.hero__frame-bar i {
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: var(--line);
	}

	.hero__frame-bar i:first-child {
		background: var(--orange);
	}

	.hero__frame img {
		width: 100%;
		max-height: 540px;
		object-fit: cover;
		object-position: top;
	}

	.hero__caption {
		margin-top: 12px;
		text-align: right;
	}

	@media (max-width: 900px) {
		.hero__inner {
			grid-template-columns: 1fr;
		}

		.hero__motif {
			display: none;
		}
	}
</style>
