---
import { storyblokEditable } from '@storyblok/astro';
const { blok } = Astro.props;
const features: string[] = (blok.features || '')
	.split('\n')
	.map((line: string) => line.trim())
	.filter(Boolean);
---

<article class:list={['card', 'plan', 'reveal', { 'plan--highlight': blok.highlight }]} {...storyblokEditable(blok)}>
	{blok.highlight && blok.highlight_label && <p class="plan__flag">{blok.highlight_label}</p>}
	<h3 class="plan__name">{blok.name}</h3>
	<p class="plan__price">
		<span class="plan__amount">{blok.price}</span>
		{blok.period && <span class="plan__period">/ {blok.period}</span>}
	</p>
	{blok.description && <p class="plan__desc">{blok.description}</p>}
	<ul class="plan__features">
		{features.map((feature) => <li>{feature}</li>)}
	</ul>
	{
		blok.cta_label && (
			<a class:list={['btn', blok.highlight ? 'btn--primary' : 'btn--ghost', 'plan__cta']} href={blok.cta_link || '#cta'}>
				{blok.cta_label}
			</a>
		)
	}
</article>

<style>
	.plan {
		display: flex;
		flex-direction: column;
		position: relative;
	}

	.plan--highlight {
		border-color: var(--orange);
		box-shadow: 0 0 0 1px var(--orange), var(--shadow-card);
	}

	.plan__flag {
		position: absolute;
		top: -13px;
		left: 24px;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		background: var(--orange);
		color: var(--navy-deep);
		padding: 4px 12px;
		border-radius: 999px;
	}

	.plan__name {
		font-size: 1.05rem;
		font-weight: 600;
	}

	.plan__price {
		margin-top: 14px;
		display: flex;
		align-items: baseline;
		gap: 6px;
	}

	.plan__amount {
		font-size: 2.1rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		font-variant-numeric: tabular-nums;
	}

	.plan__period {
		color: var(--text-muted);
		font-size: 0.88rem;
	}

	.plan__desc {
		margin-top: 10px;
		color: var(--text-muted);
		font-size: 0.92rem;
	}

	.plan__features {
		list-style: none;
		margin-top: 20px;
		display: grid;
		gap: 10px;
		font-size: 0.92rem;
		flex-grow: 1;
	}

	.plan__features li {
		padding-left: 24px;
		position: relative;
	}

	.plan__features li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 7px;
		width: 12px;
		height: 7px;
		border-left: 2px solid var(--forest);
		border-bottom: 2px solid var(--forest);
		transform: rotate(-45deg);
	}

	.plan__cta {
		margin-top: 26px;
		justify-content: center;
	}
</style>
