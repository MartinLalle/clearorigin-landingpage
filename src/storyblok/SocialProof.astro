---
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';
import { storyblokEditable } from '@storyblok/astro';
const { blok } = Astro.props;
---

<section class="section section--navy" id="proof" {...storyblokEditable(blok)}>
	<div class="container">
		{blok.eyebrow && <p class="eyebrow">{blok.eyebrow}</p>}
		<h2 class="section-title">{blok.title}</h2>
		{blok.intro && <p class="section-intro">{blok.intro}</p>}

		{
			blok.stats?.length > 0 && (
				<dl class="proof__stats">
					{blok.stats.map((stat: any) => (
						<div class="proof__stat" {...storyblokEditable(stat)}>
							<dd>{stat.value}</dd>
							<dt>{stat.label}</dt>
						</div>
					))}
				</dl>
			)
		}

		<div class="proof__quotes">
			{blok.testimonials?.map((item: any) => <StoryblokComponent blok={item} />)}
		</div>
	</div>
</section>

<style>
	.proof__stats {
		margin-top: 48px;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
		gap: 18px;
	}

	.proof__stat {
		border: 1px solid var(--navy-soft);
		border-radius: var(--radius);
		padding: 22px 24px;
	}

	.proof__stat dd {
		font-size: 1.9rem;
		font-weight: 700;
		color: var(--orange);
		font-variant-numeric: tabular-nums;
	}

	.proof__stat dt {
		margin-top: 6px;
		font-size: 0.88rem;
		color: var(--text-inverse-muted);
	}

	.proof__quotes {
		margin-top: 40px;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 22px;
	}
</style>
