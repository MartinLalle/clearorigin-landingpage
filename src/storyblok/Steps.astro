---
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';
import { storyblokEditable } from '@storyblok/astro';
const { blok } = Astro.props;
---

<section class="section" id="how" {...storyblokEditable(blok)}>
	<div class="container">
		{blok.eyebrow && <p class="eyebrow">{blok.eyebrow}</p>}
		<h2 class="section-title">{blok.title}</h2>
		{blok.intro && <p class="section-intro">{blok.intro}</p>}
		<ol class="steps__list">
			{blok.items?.map((item: any, index: number) => <StoryblokComponent blok={item} index={index} />)}
		</ol>
	</div>
</section>

<style>
	.steps__list {
		list-style: none;
		margin-top: 56px;
		display: grid;
		gap: 0;
		position: relative;
	}

	/* The supply-chain thread: a dashed line linking every step, parcel → importer */
	.steps__list::before {
		content: '';
		position: absolute;
		left: 27px;
		top: 10px;
		bottom: 10px;
		width: 0;
		border-left: 1.5px dashed var(--orange);
		opacity: 0.55;
	}

	@media (max-width: 720px) {
		.steps__list::before {
			left: 21px;
		}
	}
</style>
