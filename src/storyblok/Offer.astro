---
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';
import { storyblokEditable } from '@storyblok/astro';
const { blok } = Astro.props;
---

<section class="section" id="offer" {...storyblokEditable(blok)}>
	<div class="container offer__inner">
		<div>
			{blok.eyebrow && <p class="eyebrow">{blok.eyebrow}</p>}
			<h2 class="section-title">{blok.title}</h2>
			{blok.intro && <p class="section-intro">{blok.intro}</p>}
			<ul class="offer__list">
				{blok.items?.map((item: any) => <StoryblokComponent blok={item} />)}
			</ul>
		</div>
		{
			blok.bonus_title && (
				<aside class="offer__bonus reveal">
					<p class="offer__bonus-kicker geo-tag">+ Bonus</p>
					<h3 class="offer__bonus-title">{blok.bonus_title}</h3>
					<p class="offer__bonus-text">{blok.bonus_text}</p>
				</aside>
			)
		}
	</div>
</section>

<style>
	.offer__inner {
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
		gap: 56px;
		align-items: start;
	}

	.offer__list {
		list-style: none;
		margin-top: 36px;
		display: grid;
		gap: 14px;
	}

	.offer__bonus {
		background: var(--orange-soft);
		border: 1.5px dashed var(--orange);
		border-radius: var(--radius);
		padding: 30px;
		position: sticky;
		top: 96px;
	}

	.offer__bonus-kicker {
		color: var(--orange-deep);
		font-weight: 500;
	}

	.offer__bonus-title {
		margin-top: 10px;
		font-size: 1.2rem;
		font-weight: 600;
	}

	.offer__bonus-text {
		margin-top: 10px;
		color: var(--text-muted);
		font-size: 0.95rem;
	}

	@media (max-width: 900px) {
		.offer__inner {
			grid-template-columns: 1fr;
		}

		.offer__bonus {
			position: static;
		}
	}
</style>
