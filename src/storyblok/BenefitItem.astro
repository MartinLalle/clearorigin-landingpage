---
import { storyblokEditable } from '@storyblok/astro';
const { blok } = Astro.props;

const ICONS: Record<string, string> = {
	'map-pin':
		'M12 21s-7-5.1-7-11a7 7 0 1 1 14 0c0 5.9-7 11-7 11Zm0-8.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z',
	'file-check': 'M6 2h9l5 5v15H6V2Zm8 0v6h6M9.5 14.5l2 2 4-4.5',
	satellite:
		'M13 7 17 3l4 4-4 4m-8 2-4 4 4 4 4-4m-5-5 6 6m2.5-8.5 3 3M4.5 13.5l3 3',
	share:
		'M18 8a3 3 0 1 0-2.8-4M18 8a3 3 0 0 1-2.8-2M6 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm12 7a3 3 0 1 0-2.8-4M8.7 10.7l6.6-3.4m-6.6 6 6.6 3.4',
	shield: 'M12 2l8 3v7c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V5l8-3Zm-3.5 10 2.5 2.5 4.5-5',
	clock: 'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Zm0-14v6l4 2',
};

const iconPath = ICONS[blok.icon] || ICONS['map-pin'];
---

<article class="card benefit reveal" {...storyblokEditable(blok)}>
	<span class="benefit__icon" aria-hidden="true">
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
			<path d={iconPath}></path>
		</svg>
	</span>
	<h3 class="benefit__title">{blok.title}</h3>
	<p class="benefit__text">{blok.text}</p>
</article>

<style>
	.benefit__icon {
		display: inline-flex;
		width: 46px;
		height: 46px;
		align-items: center;
		justify-content: center;
		border-radius: 12px;
		background: var(--orange-soft);
		color: var(--orange-deep);
	}

	.benefit__icon svg {
		width: 24px;
		height: 24px;
	}

	.benefit__title {
		margin-top: 18px;
		font-size: 1.08rem;
		font-weight: 600;
	}

	.benefit__text {
		margin-top: 8px;
		color: var(--text-muted);
		font-size: 0.95rem;
	}
</style>
