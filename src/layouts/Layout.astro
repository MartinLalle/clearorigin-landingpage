---
import '../styles/global.css';

interface Props {
	lang: string;
	title: string;
	description: string;
}

const { lang, title, description } = Astro.props;

const LANGS = [
	{ code: 'fr', label: 'FR', path: '/' },
	{ code: 'en', label: 'EN', path: '/en/' },
	{ code: 'es', label: 'ES', path: '/es/' },
	{ code: 'pt', label: 'PT', path: '/pt/' },
];

const CHROME: Record<string, { cta: string; developedBy: string; legal: string }> = {
	fr: { cta: 'Demander une démo', developedBy: 'Une solution par', legal: 'Tous droits réservés' },
	en: { cta: 'Request a demo', developedBy: 'A solution by', legal: 'All rights reserved' },
	es: { cta: 'Solicitar una demo', developedBy: 'Una solución de', legal: 'Todos los derechos reservados' },
	pt: { cta: 'Pedir uma demo', developedBy: 'Uma solução por', legal: 'Todos os direitos reservados' },
};

const chrome = CHROME[lang] ?? CHROME.fr;
const currentYear = new Date().getFullYear();
const site = Astro.site?.href?.replace(/\/$/, '') ?? '';
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="icon" type="image/png" href="/images/logo_icon_orange.png" />
		<meta name="generator" content={Astro.generator} />
		{LANGS.map((l) => <link rel="alternate" hreflang={l.code} href={`${site}${l.path}`} />)}
		<link rel="alternate" hreflang="x-default" href={`${site}/`} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500&display=swap"
		/>
	</head>
	<body>
		<header class="site-header">
			<div class="container site-header__inner">
				<a href={LANGS.find((l) => l.code === lang)?.path ?? '/'} class="site-header__brand">
					<img src="/images/logo_orange.png" alt="ClearOrigin" width="170" height="27" />
				</a>
				<nav class="site-header__nav" aria-label="Language">
					<ul class="lang-switch">
						{
							LANGS.map((l) => (
								<li>
									<a href={l.path} aria-current={l.code === lang ? 'page' : undefined}>
										{l.label}
									</a>
								</li>
							))
						}
					</ul>
					<a href="#cta" class="btn btn--primary site-header__cta">{chrome.cta}</a>
				</nav>
			</div>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="container site-footer__inner">
				<img src="/images/logo_orange.png" alt="ClearOrigin" width="150" height="24" class="site-footer__logo" />
				<p class="site-footer__by">{chrome.developedBy} <strong>BF Consult</strong></p>
				<p class="geo-tag">© {currentYear} — {chrome.legal}</p>
			</div>
		</footer>

		<script>
			// Scroll reveal — masqué seulement une fois le JS actif (.has-js), avec
			// un filet de sécurité : tout est révélé après 3 s même sans scroll.
			document.documentElement.classList.add('has-js');
			const reveal = (el: Element) => el.classList.add('is-visible');
			const observer = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (entry.isIntersecting) {
							reveal(entry.target);
							observer.unobserve(entry.target);
						}
					}
				},
				{ threshold: 0.12 }
			);
			const elements = document.querySelectorAll('.reveal');
			elements.forEach((el) => observer.observe(el));
			setTimeout(() => elements.forEach(reveal), 3000);
		</script>
	</body>
</html>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		background: rgba(255, 255, 255, 0.9);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--line);
	}

	.site-header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-block: 14px;
		gap: 16px;
	}

	.site-header__brand img {
		height: 27px;
		width: auto;
	}

	.site-header__nav {
		display: flex;
		align-items: center;
		gap: 22px;
	}

	.lang-switch {
		display: flex;
		gap: 4px;
		list-style: none;
	}

	.lang-switch a {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 500;
		text-decoration: none;
		padding: 6px 9px;
		border-radius: 6px;
		color: var(--text-muted);
	}

	.lang-switch a:hover {
		color: var(--text);
		background: var(--mist);
	}

	.lang-switch a[aria-current='page'] {
		color: var(--orange-deep);
		background: var(--orange-soft);
	}

	.site-header__cta {
		padding: 10px 20px;
		font-size: 0.9rem;
	}

	.site-footer {
		border-top: 1px solid var(--line);
		background: var(--mist);
		padding-block: 40px;
	}

	.site-footer__inner {
		display: flex;
		align-items: center;
		gap: 20px;
		flex-wrap: wrap;
		justify-content: space-between;
	}

	.site-footer__logo {
		height: 24px;
		width: auto;
	}

	.site-footer__by {
		font-size: 0.9rem;
		color: var(--text-muted);
	}

	@media (max-width: 720px) {
		.site-header__cta {
			display: none;
		}
	}
</style>
