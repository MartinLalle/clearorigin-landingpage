STORYBLOK_DELIVERY_API_TOKEN=<REPLACE_WITH_YOUR_TOKEN>
STORYBLOK_REGION=<REPLACE_WITH_SPACE_REGION>

# Space ID (Storyblok > Settings > General) - requis par npm run push:storyblok
STORYBLOK_SPACE_ID=<REPLACE_WITH_SPACE_ID>

# Personal access token Management API (Storyblok > My account > Personal access tokens)
# Alternative : `npx storyblok@latest login` avec le compte proprietaire du space
# STORYBLOK_MANAGEMENT_TOKEN=
# Optionnel : endpoint API custom (proxy, self-hosted) — l'origin est suffixé de /v2
# STORYBLOK_API_BASE_URL=

# Secret partagé avec le webhook Storyblok (POST /api/revalidate/?secret=...)
# Générer avec : openssl rand -hex 20
STORYBLOK_REVALIDATE_SECRET=<REPLACE_WITH_A_RANDOM_SECRET>
